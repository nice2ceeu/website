{
  "name": "lightmare-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs",
    "db:order-items": "node --env-file=.env.local --import tsx scripts/setup-order-items.ts",
    "db:products": "node --env-file=.env.local --import tsx scripts/setup-products.ts",
    "db:cms": "node --env-file=.env.local --import tsx scripts/setup-cms.ts",
    "db:rebrand": "node --env-file=.env.local --import tsx scripts/rebrand-lightmare-ph.ts",
    "images:migrate": "node --env-file=.env.local --import tsx scripts/migrate-cloudinary.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:create": "node --env-file=.env.local scripts/admin-account.mjs create",
    "admin:reset": "node --env-file=.env.local scripts/admin-account.mjs reset",
    "addresses:update": "node scripts/update-addresses.mjs",
    "postal:update": "node scripts/update-postal-codes.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "mysql2": "^3.24.5",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
