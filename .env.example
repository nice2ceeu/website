# Copy to .env.local. Never commit credentials.
APP_URL=http://localhost:3000
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
MYSQL_CA_PATH=certs/ca.pem
# Alternative: quoted PEM text with escaped newline separators.
MYSQL_CA=
# Admin email and password hashes are stored in MySQL. Run npm run admin:create.
# Generate a random secret of at least 32 characters for signing sessions.
SESSION_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
ORDER_NOTIFICATION_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
